# Backend runtime environment.
APP_ENV=development

# Backend log verbosity.
LOG_LEVEL=INFO

# Allowed document extensions and maximum upload size (10 MB).
UPLOAD_ALLOWED_EXTENSIONS=[".txt", ".pdf", ".md"]
UPLOAD_MAX_SIZE_BYTES=10485760

# Document chunking
chunk_size=300
chunk_overlap=30

# Langfuse credentials and endpoint.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=
LLM_PROMPT_NAME=first_prompt

# Qdrant credentials and endpoint.
Qdrant_API_KEY=
Qdrant_URL=
QDRANT_COLLECTION_NAME=personal-ai-cortex

# Embedding model.
EMBED_MODEL=qwen3-embedding:0.6b
EMBED_DIM=1024
EMBED_CONTEXT=32000

# LLM provider: ollama, groq, openrouter, or google.
LLM_PROVIDER=ollama

# Ollama (OpenAI-compatible endpoint; use host.docker.internal in Docker if Ollama runs on the host).
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=gemma4:e4b

# Groq.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# Google Gemini via the native Google Gen AI SDK.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# Shared generation settings.
LLM_CONTEXT=128000
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7
