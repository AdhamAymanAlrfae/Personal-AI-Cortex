# Backend runtime environment.
APP_ENV=development

# Backend log verbosity.
LOG_LEVEL=INFO

# Langfuse credentials and endpoint.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# Qdrant credentials and endpoint.
Qdrant_API_KEY=
Qdrant_URL=

# Embedding model.
EMBED_MODEL=qwen3-embedding:0.6b
EMBED_DIM=1024
EMBED_CONTEXT=32000

# LLM model.
LLM_MODEL=gemma4:e4b
LLM_CONTEXT=128000
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7
