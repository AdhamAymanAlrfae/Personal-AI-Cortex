# Backend runtime environment.
APP_ENV=development

# Backend log verbosity.
LOG_LEVEL=INFO

# Allowed document extensions and maximum upload size (10 MB).
UPLOAD_ALLOWED_EXTENSIONS=[".txt", ".pdf", ".md"]
UPLOAD_MAX_SIZE_BYTES=10485760

# Document chunking
chunk_size=300
chunk_overlap=30

# Langfuse credentials and endpoint.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# Qdrant credentials and endpoint.
Qdrant_API_KEY=
Qdrant_URL=
QDRANT_COLLECTION_NAME=personal-ai-cortex

# Embedding model.
EMBED_MODEL=qwen3-embedding:0.6b
EMBED_DIM=1024
EMBED_CONTEXT=32000

# LLM model.
LLM_MODEL=gemma4:e4b
LLM_CONTEXT=128000
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7
